---
import { commentsArray } from "$lib/comments/instagram.ts";
import Instagram from "$lib/components/comments/Instagram.astro";

interface commentData {
  id: number;
  content: string;
}

interface Props {
  comment: commentData;
}

export function getStaticPaths() {
  return commentsArray.map((comment) => ({
    params: {
      id: comment[0].toString(),
    },
    props: {
      comment: {
        id: comment[0],
        content: comment[1],
      },
    },
  }));
}

const { id, content } = Astro.props.comment;
---

<Instagram userSeed={id.toString()} content={content} />
