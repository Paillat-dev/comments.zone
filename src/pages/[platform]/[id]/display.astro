---
import { getCommentStaticPaths } from "$lib/platforms";
import type { CommentRouteProps } from "$lib/platforms";
import { getImage } from "astro:assets";
import Layout from "$lib/components/Layout.astro";
import CommentCard from "$lib/components/comments/CommentCard.astro";
import { OG_WIDTH, OG_HEIGHT } from "$lib/og/common";

export const getStaticPaths = getCommentStaticPaths;

type Props = CommentRouteProps;

const { platform, comment }: Props = Astro.props;

const ogImageAsset = await getImage({
  src: `/${platform}/${comment.id}/og.png`,
  width: OG_WIDTH,
  height: OG_HEIGHT,
  format: "png",
});

const ogImage = new URL(ogImageAsset.src, Astro.site ?? Astro.url);
---

<Layout
  title={`comments.zone | ${comment.id}`}
  image={{ url: ogImage, width: OG_WIDTH, height: OG_HEIGHT }}
>
  <CommentCard platform={platform} comment={comment} />
</Layout>
