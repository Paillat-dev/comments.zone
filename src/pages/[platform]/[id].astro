---
import Instagram from "$lib/components/comments/Instagram.astro";
import {
  getCommentStaticPaths,
  type CommentRouteProps,
  type PlatformKey,
} from "$lib/platforms";

const components: Record<PlatformKey, typeof Instagram> = {
  i: Instagram,
};

type Props = CommentRouteProps;

export const getStaticPaths = getCommentStaticPaths;

const { platform, comment } = Astro.props;
const Comment = components[platform];
---

<meta name="robots" content="noindex" />
<Comment userSeed={comment.id.toString()} content={comment.content} />
