---
import CommentCard from "$lib/components/comments/CommentCard.astro";
import { getCommentStaticPaths, type CommentRouteProps } from "$lib/platforms";

type Props = CommentRouteProps;

export const getStaticPaths = getCommentStaticPaths;

const { platform, comment } = Astro.props;
---

<meta name="robots" content="noindex" />
<CommentCard platform={platform} comment={comment} />
