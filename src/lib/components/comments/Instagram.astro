---
import { getCommentDisplayData } from "$lib/comments/instagram";
import { Heart } from "@lucide/astro";
import { twMerge } from "tailwind-merge";

interface Props {
  userSeed: string;
  content: string;
  class?: string;
}

const { userSeed, content, class: className } = Astro.props;

const { username, avatar, numLikes, weeksAge, segments } =
  getCommentDisplayData(userSeed, content);
---

<article
  class={twMerge("flex max-w-5xl flex-row bg-ig-background p-16", className)}
>
  <img
    src={avatar.toDataUri()}
    alt={`Avatar for user ${userSeed}`}
    class="mr-4 aspect-square h-16 w-16 rounded-full bg-ig-muted"
  />
  <div
    class="mr-10 ml-4 flex flex-col gap-1 font-ig text-base text-ig-foreground md:text-xl"
  >
    <div class="flex flex-row gap-2">
      <span class="font-semibold">{username}</span><span
        class="font-medium text-ig-muted">{weeksAge}w</span
      >
    </div>
    <div class="font-normal">
      {
        segments.map((segment) =>
          segment.type === "mention" ? (
            <span class="text-blue-500">@{segment.username}</span>
          ) : (
            segment.value
          ),
        )
      }
    </div>
    <div class="font-semibold text-ig-muted">Reply</div>
  </div>
  <div class="my-5 ml-10 flex flex-col gap-1 font-semibold text-ig-muted">
    <Heart class="mx-auto" />
    <span>{numLikes}</span>
  </div>
</article>
